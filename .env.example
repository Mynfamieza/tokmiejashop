# TokMieja Shop - environment variables
#
# Copy this file to `.env.local` and fill in the values from your own
# Supabase project (Project Settings -> API).
#
# `.env.local` is ignored by Git. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE:
# Only the public anon key belongs here. A service-role key must NEVER be
# exposed to the browser or committed. Server-only secrets (if any are added
# in later phases) must use a non `NEXT_PUBLIC_` name and stay on the server.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Customer support WhatsApp number (public, not a secret). Digits only with
# country code, e.g. 60123456789. Leave empty to hide the WhatsApp contact CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=
