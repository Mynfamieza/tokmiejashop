# TokMieja Shop - environment variables
#
# Copy this file to `.env.local` and fill in the values from your own
# Supabase project (Project Settings -> API).
#
# `.env.local` is ignored by Git. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE:
# Only the public anon key belongs here. A service-role key must NEVER be
# exposed to the browser or committed. Server-only secrets (if any are added
# in later phases) must use a non `NEXT_PUBLIC_` name and stay on the server.

# --- ToyyibPay (Phase 7B) ---
# Server-only. Never prefix the secret key with NEXT_PUBLIC_.
# Sandbox base URL: https://dev.toyyibpay.com
# Production base URL: https://toyyibpay.com
TOYYIBPAY_API_URL=https://dev.toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Enable DuitNow QR on the bill. Set to 0 if DuitNow QR is not activated on
# your ToyyibPay account (FPX is always enabled).
TOYYIBPAY_ENABLE_DUITNOW_QR=1

# Public base URL used to build the ToyyibPay return and callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Customer support WhatsApp number (public, not a secret). Digits only with
# country code, e.g. 60123456789. Leave empty to hide the WhatsApp contact CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# The ToyyibPay user secret key is ALSO inserted into the database
# (public.app_settings.toyyibpay_secret_key) so the callback hash can be
# verified server-side (see the README). It is never committed to Git.
